# systemd.path unit: restart rousseau-agent whenever Claude Code
# atomically rewrites either the OAuth credentials file or the
# top-level configuration file on the host.
#
# WHY
#
# Two host-side files are bind-mounted into the container at the
# FILE level (not the DIR level):
#
#   * %h/.claude.json         — permission profile, MCP registry,
#                               per-project session index
#   * %h/.claude/.credentials.json — OAuth access + refresh tokens
#
# The .claude/ DIRECTORY is dir-bound, so files replaced within it
# stay visible. .claude.json lives at HOME root, and HOME cannot be
# bind-mounted, so it needs its own FILE bind. Both files are
# rewritten by Claude Code via atomic unlink + rename -- the new
# content lands under a fresh inode, the container keeps holding
# the deleted one, and every subprocess after replacement dies with:
#
#   Failed to authenticate: OAuth session expired and could not be
#   refreshed
#
# or (for .claude.json)
#
#   Claude configuration file not found at: /home/rousseau/.claude.json
#
# WHAT
#
# systemd watches both files for change events and, when either
# fires, triggers rousseau-agent-claude-creds.service which restarts
# the main service. Podman re-resolves file binds at container
# start, so the fresh inodes are picked up immediately.
#
# NOTE ON .credentials.json
#
# The dir-level bind of %h/.claude/ that PR #50 introduced means
# .credentials.json inside it survives atomic replaces without any
# watcher help — files replaced within a dir bind stay visible.
# The watch here is defence in depth: if the mount design ever
# reverts to a file bind on credentials.json (as it was before
# PR #50), the daemon still recovers.
#
# Install:
#   cp docker/rousseau-agent-claude-creds.{path,service} \
#      $XDG_CONFIG_HOME/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now rousseau-agent-claude-creds.path

[Unit]
Description=Watch Claude configuration + credentials for host-side refresh
Documentation=https://github.com/sebastienrousseau/rousseau-agent/blob/main/docker/README.md#claude-oauth-refresh

[Path]
# PathChanged fires on file-close-after-write. systemd re-arms the
# inotify watch after IN_DELETE_SELF, so an atomic unlink+rename
# (Claude Code's rewrite pattern) is caught.
PathChanged=%h/.claude.json
PathChanged=%h/.claude/.credentials.json
Unit=rousseau-agent-claude-creds.service

[Install]
WantedBy=default.target
