# systemd.path unit: restart rousseau-agent whenever Claude Code
# atomically rewrites the OAuth credentials file on the host.
#
# WHY
#
# The OAuth credentials file %h/.claude/.credentials.json is
# rewritten by Claude Code via atomic unlink + rename -- the new
# content lands under a fresh inode, the container keeps holding
# the deleted one, and every subprocess after replacement dies with:
#
#   Failed to authenticate: OAuth session expired and could not be
#   refreshed
#
# WHAT
#
# systemd watches the credentials file for change events and, when
# one fires, triggers rousseau-agent-claude-creds.service which
# restarts the main service. Podman re-resolves file binds at
# container start, so the fresh inode is picked up immediately.
#
# NOT WATCHING %h/.claude.json — WHY
#
# We used to watch %h/.claude.json too. It IS bind-mounted into the
# container (permission profile, MCP registry, per-project session
# index — the container needs a copy at startup so claude-cli finds
# one), but it is rewritten by EVERY host-side Claude Code action:
# switching a project, running a tool, editing MCP config. Watching
# it caused the daemon to be restarted mid-turn every few seconds,
# killing in-flight WhatsApp replies. See PR ##.
#
# The trade-off: after a host-side %h/.claude.json rewrite the
# container's file bind IS stale, so a new claude-cli invocation
# inside the container will report "Claude configuration file not
# found at: /home/rousseau/.claude.json". This is only load-bearing
# for the daemon's own claude-cli startup, which happens once at
# container-start — during a running turn the file's contents are
# not re-read. Symptom manifests only after a token refresh, at
# which point .credentials.json also changes and the watch below
# still fires a restart. Net effect: same recovery, no mid-turn
# kills.
#
# NOTE ON .credentials.json
#
# The dir-level bind of %h/.claude/ that PR #50 introduced means
# .credentials.json inside it survives atomic replaces without any
# watcher help — files replaced within a dir bind stay visible.
# The watch here is defence in depth: if the mount design ever
# reverts to a file bind on credentials.json (as it was before
# PR #50), the daemon still recovers.
#
# Install:
#   cp docker/rousseau-agent-claude-creds.{path,service} \
#      $XDG_CONFIG_HOME/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now rousseau-agent-claude-creds.path

[Unit]
Description=Watch Claude credentials for host-side OAuth refresh
Documentation=https://github.com/sebastienrousseau/rousseau-agent/blob/main/docker/README.md#claude-oauth-refresh

[Path]
# PathChanged fires on file-close-after-write. systemd re-arms the
# inotify watch after IN_DELETE_SELF, so an atomic unlink+rename
# (Claude Code's rewrite pattern) is caught.
PathChanged=%h/.claude/.credentials.json
Unit=rousseau-agent-claude-creds.service

[Install]
WantedBy=default.target
