# syntax=docker/dockerfile:1.7
#
# Distroless runtime for rousseau-agent — same binary as :latest but
# without the Node.js runtime and the claude CLI. Operators supply
# claude-code on the host and bind-mount it into the container, or
# use a direct provider (anthropic / bedrock / vertex / openai /
# openrouter / ollama).
#
# Target size: ~30 MB (vs 530 MB for :latest).

########################  BUILDER  ########################
# Digest-pinned (L-28): the same multi-arch index as docker/Dockerfile;
# keep the three in step. golang:1.26.8-alpine3.24 as of 2026-10-08.
FROM golang:1.27.1-alpine3.24@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

ARG VERSION=container
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux \
    go build \
        -trimpath \
        -ldflags="-s -w \
          -X 'github.com/sebastienrousseau/rousseau-agent/internal/cli.version=${VERSION}' \
          -X 'github.com/sebastienrousseau/rousseau-agent/internal/cli.commit=${COMMIT}' \
          -X 'github.com/sebastienrousseau/rousseau-agent/internal/cli.buildDate=${BUILD_DATE}'" \
        -o /out/rousseau ./cmd/rousseau

########################  RUNTIME  ########################
# distroless static — no shell, no libc, no package manager. Runs
# under a non-root user (UID 65532) by default. TLS certificates are
# baked in via /etc/ssl/certs/ca-certificates.crt.
# gcr.io/distroless/static-debian12:nonroot (multi-arch index) as of
# 2026-10-08. Refresh: the Docker-Content-Digest header of
#   https://gcr.io/v2/distroless/static-debian12/manifests/nonroot
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab AS runtime

COPY --from=builder /out/rousseau /usr/local/bin/rousseau

# distroless already runs as nonroot (UID 65532); no USER directive
# needed. HOME is set to /home/nonroot by the base image.
WORKDIR /workspace
ENV HOME=/home/nonroot

# No HTTP surface — nothing to expose. Health is process-alive.
ENTRYPOINT ["/usr/local/bin/rousseau"]
CMD ["--help"]
