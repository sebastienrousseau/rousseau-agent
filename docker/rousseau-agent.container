# Podman Quadlet unit for the rousseau-agent WhatsApp daemon.
#
# Enable with:
#     systemctl --user daemon-reload
#     systemctl --user enable --now rousseau-agent
#
# Inspect logs with:
#     journalctl --user -u rousseau-agent -f
#
# The image is built locally from
# ~/team-rousseau-workspace/repos/public/go/rousseau-agent/docker/Dockerfile
# and tagged rousseau-agent:local. Rebuild after code changes with:
#     cd ~/team-rousseau-workspace/repos/public/go/rousseau-agent
#     podman build -t rousseau-agent:local -f docker/Dockerfile .

[Unit]
Description=rousseau-agent WhatsApp bridge
After=network-online.target
Wants=network-online.target
# Stop restart-looping if the image is genuinely broken: at most 5
# restarts within 10 minutes, otherwise systemd marks the unit failed
# so `systemctl --user status` surfaces the real problem instead of
# hiding it behind a silent retry loop.
StartLimitBurst=5
StartLimitIntervalSec=600

[Container]
Image=localhost/rousseau-agent:local
ContainerName=rousseau-agent

# Least-privilege bind mounts. The container writes only to its own
# state and its own Claude Code config; nothing else on the host is
# visible except the workspace.
#
# Claude Code config is CONTAINER-OWNED. CLAUDE_CONFIG_DIR points
# claude at a directory holding .credentials.json, .claude.json,
# projects/ and sessions/ together, so the host's ~/.claude and
# ~/.claude.json are never mounted. Mounting them read-write let a
# tool call inside the container plant settings.json hooks, plugins,
# CLAUDE.md or MCP servers that the HOST's claude would then execute.
# It also removes the inode-staleness restarts the
# rousseau-agent-claude-creds.path unit existed for: claude refreshes
# its token in place inside this directory.
#
# One-time setup: give the container its own login rather than
# copying the host's credentials (OAuth refresh tokens rotate, so two
# copies can sign each other out). See docker/README.md.
Volume=%h/.local/share/rousseau:/home/rousseau/.local/share/rousseau:rw,Z
Volume=%h/.local/share/rousseau/claude:/home/rousseau/.claude:rw,Z
Environment=CLAUDE_CONFIG_DIR=/home/rousseau/.claude

# The workspace is read-write because the agent's coding tools edit
# files there. Anything the agent writes is later seen by the host:
# prefer a dedicated directory of agent clones over your main
# workspace, and never mount the rousseau-agent source the image is
# built from (a planted change would survive the next build).
Volume=%h/team-rousseau-workspace:/workspace:rw,Z

# No published ports — rousseau exposes no HTTP surface. Egress-only
# via pasta (rootless network stack; slirp4netns was removed in newer
# podman). Pasta blocks inbound from the host by default and is faster
# than slirp on modern kernels.
#
# Egress hardening (kernel-level, layered on top of the container
# namespace): drop everything except Meta's WhatsApp Web ranges,
# Anthropic (behind CloudFront so use domain-based filter), and
# Signal. If you want the tightest possible posture, run an
# unbound/CoreDNS resolver in an adjacent container and only allow
# outbound to that resolver + the CDN IPs it hands back. The rousseau
# binary itself makes no other network calls; every deviation is a
# bug worth flagging.
Network=pasta

# Map container UID/GID 1000 (rousseau) to the host user (seb, UID
# 1000) via a user namespace so bind-mounted files are owned as
# expected on both sides. Without this, rootless podman remaps
# container UID 1000 into the subuid range and the process can't
# write to files owned by the host user.
UserNS=keep-id

# Container will restart on crash but not attempt to loop forever on
# a broken image.
AutoUpdate=disabled

Environment=HOME=/home/rousseau
Environment=XDG_DATA_HOME=/home/rousseau/.local/share

# Read-only root filesystem plus a tmpfs for /tmp: the daemon should
# never need to mutate the image at runtime.
ReadOnly=true
Tmpfs=/tmp:rw,size=64m,mode=1777

# Drop every capability, then keep only what the Go binary needs.
# Whatsmeow opens outbound TCP — no elevated caps required.
DropCapability=all
NoNewPrivileges=true
SecurityLabelDisable=false

# Kernel isolation for the daemon.
SeccompProfile=/usr/share/containers/seccomp.json

# CLI args: run the WhatsApp subcommand. Supply your JID via the
# ROUSSEAU_WHATSAPP_ALLOW env var (Environment= below, or drop an
# EnvironmentFile= directive pointing at a systemd secret). The daemon
# refuses to start with an empty allowlist unless --allow-anyone.
Environment=ROUSSEAU_WHATSAPP_ALLOW=15551234567@s.whatsapp.net

# Required: the daemon refuses to start without an explicit claude
# permission mode. bypassPermissions lets claude attempt any tool;
# every call still passes rousseau's policy bridge (a PreToolUse hook
# asking the configured approver, audited, failing closed). For a
# narrower posture use dontAsk plus claudecli.extra_args
# ["--allowedTools", "..."].
Environment=ROUSSEAU_CLAUDECLI_PERMISSION_MODE=bypassPermissions

# Credentials the agent's tools need (e.g. a GitHub token for gh/git)
# belong in podman secrets, not EnvironmentFile=: create with
# `printf %s "$TOKEN" | podman secret create rousseau_gh_token -` and
# use a fine-grained token scoped to the repos the agent works on,
# contents read/write only, no workflow scope.
#Secret=rousseau_gh_token,type=env,target=GH_TOKEN

Exec=whatsapp

[Service]
# Restart=always brings the bridge back after crashes and transient
# failures, rate-limited by the [Unit] StartLimit* above.
#
# Exit status 78 (EX_CONFIG) means a restart cannot help: the device
# is unpaired or logged out, another client took the session, the
# client is outdated, or the number is temporarily banned. Stop there
# so the unit shows as failed (and OnFailure= can alert) instead of
# looping through QR windows. After fixing the cause:
#     systemctl --user restart rousseau-agent
Restart=always
RestartSec=10s
RestartPreventExitStatus=78
TimeoutStartSec=90s

# Refresh the host-side key staging area before every container
# start. The script reads ~/.config/rousseau/host-keys.list, copies
# each named file from ~/.ssh or ~/.gnupg into
# ~/.local/share/rousseau/keys/{ssh,gnupg}/, and exits 0 even when
# the config file is missing (nothing to copy is not an error).
# Container-side symlinks (see Dockerfile) point ~/.ssh and ~/.gnupg
# at that staging area. Install the script once:
#   install -m 0755 docker/scripts/rousseau-agent-copy-host-keys.sh \
#                    ~/.local/bin/rousseau-agent-copy-host-keys
# then customise ~/.config/rousseau/host-keys.list.
ExecStartPre=-%h/.local/bin/rousseau-agent-copy-host-keys

[Install]
WantedBy=default.target
